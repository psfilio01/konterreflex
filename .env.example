# Combined reference only. Prefer `.env.local.example` for Flutter and
# `supabase/.env.example` for local Edge Functions.
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server only, configure as Supabase secrets in deployed environments
GEMINI_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_MODERATOR=replace-me
ELEVENLABS_VOICE_ACTOR=replace-me
ELEVENLABS_VOICE_INTELLIGENCE=replace-me
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRO_PRICE_ID=price_replace-me
BILLING_RETURN_URL=http://localhost:3000/subscription

# Optional provider routing
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
STT_PROVIDER=unconfigured
TTS_PROVIDER=elevenlabs
