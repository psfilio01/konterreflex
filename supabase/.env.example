# Server-side only. Copy to an untracked supabase/.env.local for local Edge Functions.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
AI_TIMEOUT_MS=20000
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_MODERATOR=replace-me
ELEVENLABS_VOICE_ACTOR=replace-me
