# Optional language-specific overrides. The unqualified IDs remain fallbacks.
ELEVENLABS_VOICE_MODERATOR_DE=replace-me
ELEVENLABS_VOICE_ACTOR_DE=replace-me
ELEVENLABS_VOICE_INTELLIGENCE_DE=replace-me
ELEVENLABS_VOICE_MODERATOR_EN=replace-me
ELEVENLABS_VOICE_ACTOR_EN=replace-me
ELEVENLABS_VOICE_INTELLIGENCE_EN=replace-me
TTS_PROVIDER=elevenlabs
STT_PROVIDER=unconfigured
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRO_PRICE_ID=price_replace-me
BILLING_RETURN_URL=http://localhost:3000/subscription
